# Local gateway configuration. Populate secrets with `npm run setup:secrets`.
GATEWAY_KEY_HMAC_SECRET=
GATEWAY_ENCRYPTION_KEY=
GATEWAY_PORT=3003
GATEWAY_DB_PATH=./data/gateway.db
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=240000
WOOCOMMERCE_MCP_URL=http://localhost:3004/mcp
SYSTEM_MCP_URL=http://localhost:3001/mcp
INVENTORY_MCP_URL=http://localhost:3002/mcp
